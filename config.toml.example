# ~/.config/llmtop/config.toml - every entry is optional.
# The [ui] settings and the endpoints can also be set from the menu (m) and
# saved with s; that edits only these lines and keeps a .bak of the file.

[ui]
interval = 2.0        # seconds between measurements
ascii = false         # true: plain ASCII instead of braille
graph_height = "auto" # "auto", or 1-4 rows per graph
theme = "default"     # "default", "orange", a btop theme by name (dracula, nord, ...)
                      # from ~/.config/llmtop/themes, ~/.config/btop/themes or
                      # /usr/share/btop/themes, or the path to a .theme file
graph_colors = "theme" # "theme": the theme's gradient; "default": llmtop's green to
                       # red inside the theme's frames and text
background = "theme"  # "theme", "none" for the terminal's own, or an xterm-256 index

[llama]
# Which systemd units to look for, in the user and system scopes.
unit_glob_socket = "llama-*.socket"
unit_glob_service = "llama-*.service"

[endpoints]
# Servers llmtop cannot find as a unit or a process: one in a container, on another
# host, or an engine with its own binary name (llama.cpp, Ollama, vLLM, LM Studio,
# Lemonade). They get their own "Endpoints" panel, named after the host (or the
# given name) and saying which program answers. Measured over HTTP only, so no
# process CPU, memory or GPU figures. Without /slots, tok/s is the speed of the
# last finished request, shown while the server is busy; when idle it shows 0.0
# and the figure moves to the line below.
urls = []   # e.g. ["http://ai395:8090", {url = "http://192.168.178.54:8091", name = "strix-30b"}]

[ollama]
url = "http://127.0.0.1:11434"
# Used to match a loaded model to its runner process. First readable one wins.
model_dirs = [
  "/var/lib/ollama/.ollama/models",
  "/usr/share/ollama/.ollama/models",
  "~/.ollama/models",
]

[lemonade]
# Taken from the running lemond process when it passes --port.
url = "http://127.0.0.1:8000"
unit = "lemond.service"

[bench]
# Programs listed in the "benchmarks" panel: matched by program name, or by a
# folder of that name in the executable's path (colibri-27b/c/qwen36 is a colibri
# run), never by command line (earlyoom names llama-server in its own arguments).
programs = ["llama-bench", "llama-perplexity", "llama-batched-bench", "llama-cli",
            "colibri", "xdna_energy_bench", "cpu_stream", "gpu_bw", "gpu_import"]

[npu]
xrt_smi = ["/opt/xilinx/xrt/bin/xrt-smi"]
